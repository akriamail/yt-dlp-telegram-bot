# yt-dlp Video Downloader Bot — 环境配置模板
# 复制为 .env 后按需修改：
#   cp .env.example .env

# ── 共享配置 ──────────────────────────────────────────────────────────────

# 下载目录（默认 ./downloads）
DOWNLOAD_DIR=./downloads

# 限速（默认 15M）
LIMIT_RATE=15M

# 最大并发下载数（默认 2）
MAX_CONCURRENT=2

# ── Telegram Bot（二选一或全选）─────────────────────────────────────────

# 从 @BotFather 获取
TG_TOKEN=

# 你的 Telegram User ID（@userinfobot 获取）
ALLOWED_USER_ID=


# ── Rocket.Chat Bot（二选一或全选）──────────────────────────────────────

# RC 服务器地址
RC_SERVER=https://chat.akria.net

# RC 用户 ID（用户设置 → 账户 → 查看信息）
RC_USER_ID=

# RC Personal Access Token（用户设置 → 安全 → Personal Access Tokens）
RC_TOKEN=

# 监听频道/群组名（默认 渠道监控）
RC_CHANNEL=渠道监控

# RC WebSocket 重连间隔（秒，默认 5）
# RC_RECONNECT_DELAY=5


# ── WebDAV 同步（可选，配合 setup_webdav.sh）───────────────────────────

# WebDAV 账号
WEBDAV_USER=admin

# WebDAV 密码（必填）
WEBDAV_PASS=

# WebDAV 服务端口（默认 8080）
# WEBDAV_PORT=8080
